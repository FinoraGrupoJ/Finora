# ==========================================
# FINORA API - VARIABLES DE ENTORNO
# Archivo de ejemplo para entorno local/producción
# No colocar credenciales reales en este archivo
# ==========================================

# Entorno de ejecución
ENVIRONMENT=development

# Proveedor de base de datos
DB_PROVIDER=postgres

# Conexión a PostgreSQL / Neon
# Ejemplo Neon:
# postgresql://usuario:password@host.neon.tech/nombre_db?sslmode=require
DB_POSTGRES=postgresql://usuario:password@host:5432/nombre_base?sslmode=require

# Claves secretas de Flask/JWT
SECRET_KEY=change_this_secret_key
JWT_SECRET_KEY=change_this_jwt_secret_key

# Configuración opcional de Flask
FLASK_DEBUG=True
FLASK_ENV=development

# CORS / Frontend permitido
FRONTEND_URL=http://localhost:5173

# Puerto local opcional
PORT=5000